# ISC best-effort Docker Hub images: internetsystemsconsortium/bind9
BIND_TAG=9.20

# Default zone for one-shot scripts (run-all iterates all modes).
ZONE_NAME=nsec.test.example
ZONE_FILE=db.nsec.test.example

# Space-separated DNSSEC modes for ./run-all.sh
MODES="nsec nsec3 nsec3optout"

# Default zone size (MiB) for scripts/generate-zone.py when --size-mb is omitted.
# ./run-all.sh uses ZONESIZE instead (default 10); e.g. ZONESIZE=1024 ./run-all.sh
ZONE_SIZE_MB=10

# Host ports for dig against each role
PRIMARY_PORT=15353
SIGNER_PORT=15354
DISTRIBUTION_PORT=15355
