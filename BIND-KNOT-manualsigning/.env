# BIND primary (hand-signed) → Knot distribution (dnssec-validation: on)
BIND_TAG=9.20
KNOT_TAG=latest

ZONE_NAME=manual.test.example
ZONE_FILE=db.manual.test.example.signed

PRIMARY_PORT=55353
# No middle signer; keep SIGNER_* pointing at primary for shared helpers.
SIGNER_PORT=55353
DISTRIBUTION_PORT=55355
