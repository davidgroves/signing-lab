# Knot DNS Hub image (latest = current release; currently 3.6.1).
KNOT_TAG=latest

# Default zone for one-shot scripts (run-all iterates all modes).
ZONE_NAME=nsec.test.example
ZONE_FILE=db.nsec.test.example

MODES="nsec nsec3 nsec3optout"
ZONE_SIZE_MB=10

# Host ports (offset from BIND's 1535x to allow both stacks)
PRIMARY_PORT=25353
SIGNER_PORT=25354
DISTRIBUTION_PORT=25355
